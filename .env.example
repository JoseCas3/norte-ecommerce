BASE_URL=http://127.0.0.1:8000/api
SITE_URL=http://localhost:3000

# Docker Compose: copiar a .env. Nunca versionar las claves reales.
APP_KEY=
# Contraseñas diferentes y robustas; Laravel utiliza MYSQL_USER, nunca root.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=norte
MYSQL_USER=norte
MYSQL_PASSWORD=
API_URL=http://localhost:8000
FRONTEND_PORT=3000
API_PORT=8000
# Opcionales para catálogo/login; necesarios para probar pagos.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
